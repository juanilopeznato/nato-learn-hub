# ─── REQUIRED ──────────────────────────────────────────────────────────
# Supabase project credentials (Settings → API en Supabase dashboard)
VITE_SUPABASE_URL=https://hoolsigtquohayhpqgtb.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# URL pública del sitio (sin trailing slash). Se usa para canonical URLs,
# OG tags, sitemap, redirect URIs OAuth, emails Resend.
# Local: http://localhost:5173 · Prod: https://natouniversity.lovable.app (o el dominio Vercel/propio)
VITE_PUBLIC_URL=https://natouniversity.lovable.app

# ─── MERCADOPAGO ───────────────────────────────────────────────────────
# Si la app va a aceptar pagos. Si no, se puede omitir.
# Dashboard MP → Tus aplicaciones → Tu app → Credenciales.
VITE_MP_CLIENT_ID=
# El redirect URI debe coincidir EXACTO con el seteado en MP. Apunta a tu dominio
# productivo. Si migrás a Vercel, hay que registrar el nuevo dominio en MP.
VITE_MP_REDIRECT_URI=https://natouniversity.lovable.app/mp/oauth/callback

# ─── OBSERVABILITY (opcional) ──────────────────────────────────────────
# Sentry DSN (sentry.io → Project Settings → Client Keys)
VITE_SENTRY_DSN=

# ─── MULTITENANT (opcional) ────────────────────────────────────────────
# Slug del tenant por defecto cuando se accede desde el dominio raíz sin subdominio.
VITE_DEFAULT_TENANT_SLUG=nato
